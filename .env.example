# Copy to .env and fill in. Nothing here is required to run the system: with no keys at
# all it runs on the free NSE archive + Yahoo tiers and skips LLM catalyst scoring.

# ── Upstox: live tier (optional) ──────────────────────────────────────────────
# You perform the OAuth login yourself and paste the token here. This system never
# handles your credentials and never places orders — market-data endpoints only.
# Tokens expire daily around 03:30 IST; run `asymmetry auth` for the refresh steps.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=http://localhost:8080/callback

# ── LLM cascade: catalyst engine (optional but recommended) ───────────────────
# Any one key switches on news catalyst scoring. The cascade rotates across whichever
# providers are configured and falls through on rate limits.
# Free tiers: https://cloud.cerebras.ai · https://console.groq.com · https://aistudio.google.com
LLM_PROVIDER_CHAIN=cerebras,groq,gemini
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Tuning (all optional; defaults shown) ─────────────────────────────────────
# MIN_REWARD_RISK=2.0          # the gate. Below this, no plan is emitted at all.
# RISK_BUDGET_INR=5000         # rupees risked per trade, used for position sizing
# MIN_MEDIAN_TURNOVER_INR=5e7  # liquidity gate
# MACRO_MIN_R2=0.40            # below this, a macro gap is marked unreliable
# WEIGHT_CATALYST=0.35         # selection weights
# WEIGHT_RELATIVE_STRENGTH=0.25
# WEIGHT_PRICE_STRUCTURE=0.20
# WEIGHT_VOLUME=0.15
# WEIGHT_LIQUIDITY=0.05
