# Copy to .env and fill in. Nothing here is required to run the system: with no keys at
# all it runs on the free NSE archive + Yahoo tiers and skips LLM catalyst scoring.

# ── Upstox: live tier (optional) ──────────────────────────────────────────────
# You perform the OAuth login yourself and paste the token here. This system never
# handles your credentials and never places orders — market-data endpoints only.
# Tokens expire daily around 03:30 IST; run `asymmetry auth` for the refresh steps.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
# Preferred by the clean-room read-only FnO system; valid for one year.
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_REDIRECT_URI=http://localhost:8080/callback

# ── LLM cascade: catalyst engine (optional but recommended) ───────────────────
# Any one key switches on news catalyst scoring. The cascade rotates across whichever
# providers are configured and falls through on rate limits.
# Free tiers: https://cloud.cerebras.ai · https://console.groq.com · https://aistudio.google.com
LLM_PROVIDER_CHAIN=cerebras,groq,gemini
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Tuning (all optional; defaults shown) ─────────────────────────────────────
# MIN_REWARD_RISK=4.0          # V3 target multiple
# ACCOUNT_EQUITY_INR=1000000   # enables equity-based V3 sizing
# RISK_PER_TRADE_PCT=0.25      # funded phase only; used when equity is set
# RISK_BUDGET_INR=5000         # optional explicit override; legacy default without equity
# MAX_POSITION_VALUE_PCT=20.0  # notional cap as a share of equity
# MAX_CONCURRENT_POSITIONS=2
# MAX_PORTFOLIO_HEAT_PCT=0.5   # summed open risk as a share of equity
# MAX_POSITIONS_PER_SECTOR=2
# V3_MIN_PROBABILITY_2R=0.70
# V3_MIN_PROBABILITY_3R=0.55
# V3_MIN_PROBABILITY_4R=0.45
# V3_MIN_CONSERVATIVE_2R=0.60
# V3_MIN_CONSERVATIVE_3R=0.45
# V3_MIN_CONSERVATIVE_4R=0.35
# V3_MIN_CONSERVATIVE_NET_R=0.40
# V3_PROBABILITY_MIN_VALIDATION=100
# V3_PROBABILITY_MIN_SYMBOLS=30
# V3_PROBABILITY_MIN_SESSIONS=20
# V3_PROBABILITY_EMBARGO_SESSIONS=5
# V3_FORWARD_MIN_SIGNALS=30
# V3_PROBABILITY_MAX_AGE_DAYS=30
# V3_PROBABILITY_MAX_BAR_AGE_MINUTES=35
# MIN_MEDIAN_TURNOVER_INR=5e7  # liquidity gate
# MACRO_MIN_R2=0.40            # below this, a macro gap is marked unreliable
# WEIGHT_CATALYST=0.35         # selection weights
# WEIGHT_RELATIVE_STRENGTH=0.25
# WEIGHT_PRICE_STRUCTURE=0.20
# WEIGHT_VOLUME=0.15
# WEIGHT_LIQUIDITY=0.05
